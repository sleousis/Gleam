<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.1.0.0</Version>
    <Author>Raiden Shinryu</Author>
    <Name>Tidy Up</Name>
    <Punchline>One review. One click. Every bag clean.</Punchline>
    <Description>Finds the junk in your inventory, armoury, saddlebag, retainers and glamour dresser. Shows it all in one list, with icons. You accept once; it discards, sells, turns in for seals or desynths, and never touches anything you protect.</Description>
    <RepoUrl>https://github.com/savvasleousis/TidyUp</RepoUrl>
    <Tags>inventory;cleanup;discard;retainer;glamour;qol</Tags>
    <RootNamespace>TidyUp</RootNamespace>
    <AssemblyName>TidyUp</AssemblyName>
    <LangVersion>14.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TidyUp.Core\TidyUp.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Data\curated.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>true</Visible>
    </Content>
    <Content Include="images\icon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>true</Visible>
    </Content>
  </ItemGroup>
</Project>
